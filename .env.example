NEXT_PUBLIC_BASE_URL=your_key
NEXT_PUBLIC_META_PIXEL_ID=your_key
# Google Tag Manager — ID do container (GTM-XXXXXXX). Defina apenas em produção.
NEXT_PUBLIC_GTM_ID=
EMAIL_FROM=your_key
RESEND_API_KEY=your_key

# Google Search Console — método "tag HTML": cole só o valor de `content` da
# <meta name="google-site-verification">. Opcional; defina apenas em produção.
GOOGLE_SITE_VERIFICATION=
