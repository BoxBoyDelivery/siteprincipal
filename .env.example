# Valores validados com zod em src/shared/env. Vazio = não definida; um valor
# presente mas mal formado faz o `pnpm build` falhar.

# Domínio canônico (URL http(s)). Vazio usa https://boxboydelivery.com.
NEXT_PUBLIC_BASE_URL=
# Meta Pixel — só os dígitos do ID. O script só é injetado quando definido.
NEXT_PUBLIC_META_PIXEL_ID=
# Google Tag Manager — ID do container (GTM-XXXXXXX). Defina apenas em produção.
NEXT_PUBLIC_GTM_ID=

# Resend — chave (re_...) obrigatória para /api/lead enviar e-mail.
RESEND_API_KEY=
# Remetente: email@dominio ou "Nome <email@dominio>". Vazio usa
# "BoxBoy <contato@boxboydelivery.com>".
EMAIL_FROM=
# Quem recebe os leads. Vazio usa contato@boxboydelivery.com.
CONTACT_EMAIL=

# Cloudflare Turnstile (anti-robô do formulário). Defina as duas ou nenhuma.
# Sem elas, o formulário funciona sem captcha. Para testar localmente, use as
# chaves de teste da Cloudflare: 1x00000000000000000000AA (site) e
# 1x0000000000000000000000000000000AA (secret).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Search Console — método "tag HTML": cole só o valor de `content` da
# <meta name="google-site-verification">. Opcional; defina apenas em produção.
GOOGLE_SITE_VERIFICATION=
